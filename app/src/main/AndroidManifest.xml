<?xml version="1.0" encoding="utf-8"?>

<manifest
    xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- WHOOP uses Bluetooth Low Energy -->
    <uses-feature
        android:name="android.hardware.bluetooth_le"
        android:required="true" />

    <!-- Android 11 and earlier -->
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />

    <uses-permission
        android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />

    <!-- Required for BLE scanning on Android 11 and earlier -->
    <uses-permission
        android:name="android.permission.ACCESS_FINE_LOCATION"
        android:maxSdkVersion="30" />

    <!-- Android 12+ -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />

    <uses-permission
        android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- 0.5.15: ask Termux to run the ALADIN second opinion (Termux RUN_COMMAND) -->
    <uses-permission android:name="com.termux.permission.RUN_COMMAND" />
    <queries>
        <package android:name="com.termux" />
    </queries>

    <!-- All-day logger: keep running in the background and show its status -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- 0.15.0: lets the logger start the invisible link owner from the background (Android 10+ blocks background activity starts otherwise); nothing is drawn -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <application
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/AppTheme"
        android:label="NOOP MG ECG Experimental"
        android:allowBackup="false"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:label="MG Heart"
            android:screenOrientation="portrait"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 0.15.0: invisible, own task, not in recents; owns the strap link (see LinkHostActivity) -->
        <activity
            android:name=".LinkHostActivity"
            android:label="MG link"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:screenOrientation="portrait"
            android:exported="false" />

        <activity
            android:name=".DayLogActivity"
            android:label="MG Day Log"
            android:screenOrientation="portrait"
            android:exported="true" />

        <activity
            android:name=".HealthActivity"
            android:label="MG Heart"
            android:screenOrientation="portrait"
            android:exported="false" />

        <!-- 0.20.0: every frame the strap sends, live -->
        <activity
            android:name=".LiveFramesActivity"
            android:label="Live frames"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
            android:exported="false" />

        <!-- 0.19.2: the report viewer lives in its own process so that the logger process never loads WebView -->
        <activity
            android:name=".ReportActivity"
            android:label="ECG report"
            android:process=":report"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
            android:screenOrientation="portrait"
            android:exported="false" />

        <activity
            android:name=".TodayActivity"
            android:label="MG Today"
            android:screenOrientation="portrait"
            android:exported="false" />

        <activity
            android:name=".ActivityActivity"
            android:label="MG Activity"
            android:screenOrientation="portrait"
            android:exported="false" />

        <activity
            android:name=".AladinActivity"
            android:label="ALADIN second opinion"
            android:screenOrientation="portrait"
            android:exported="false" />

        <receiver
            android:name=".AladinResultReceiver"
            android:exported="true" />

        <service
            android:name=".DayLogService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <receiver
            android:name=".DayLogReceiver"
            android:exported="false" />

        <!-- 0.19.0: the 15 minute alarm that brings the logger back if Android ended the process -->
        <receiver
            android:name=".LoggerAlarmReceiver"
            android:exported="false" />

        <!-- The daily backup: the alarm, and the foreground service that does the copying -->
        <receiver
            android:name=".BackupReceiver"
            android:exported="false" />

        <service
            android:name=".BackupService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- After a restart or an app update: one alert that reconnects the strap when tapped -->
        <receiver
            android:name=".DayLogBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
