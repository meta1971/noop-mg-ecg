<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ecg_w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/ecg_w_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ECG"
        android:textColor="#98A3B3"
        android:textSize="11sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/ecg_w_l1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="No readings yet"
        android:textColor="#F2F6FA"
        android:textSize="17sp"
        android:textStyle="bold"
        android:maxLines="1" />

    <TextView
        android:id="@+id/ecg_w_l2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="#C9D2DE"
        android:textSize="12sp"
        android:maxLines="1" />

    <TextView
        android:id="@+id/ecg_w_l3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text=""
        android:textColor="#98A3B3"
        android:textSize="11sp"
        android:maxLines="2" />

    <TextView
        android:id="@+id/ecg_w_btn"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="Take an ECG"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold" />
</LinearLayout>
